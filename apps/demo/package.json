{
  "name": "@lowdefy/modules-demo",
  "version": "0.0.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "ldf:b": "AUTH_SECRET=${AUTH_SECRET:-build-only-not-a-real-secret} lowdefy build",
    "ldf:d": "lowdefy dev --log-level=debug --no-open",
    "ldf:s": "lowdefy start",
    "ldf": "lowdefy dev --no-open",
    "ldf:b:i": "infisical run --env=dev --path=/apps/demo -- lowdefy build",
    "ldf:d:i": "infisical run --env=dev --path=/apps/demo -- lowdefy dev --log-level=debug --no-open",
    "ldf:s:i": "infisical run --env=dev --path=/apps/demo -- lowdefy start",
    "ldf:i": "infisical run --env=dev --path=/apps/demo -- lowdefy dev --no-open",
    "e2e": "playwright test --config=e2e/playwright.config.js",
    "e2e:headed": "SLOW_MO=500 playwright test --headed --workers=1 --config=e2e/playwright.config.js",
    "e2e:ui": "playwright test --ui --config=e2e/playwright.config.js",
    "e2e:server": "lowdefy build --server e2e && lowdefy start --port 3101 --log-level warn",
    "reporting:seed": "infisical run --env=dev --path=/apps/demo -- node scripts/seed-reporting-domain.mjs",
    "reporting:catalog": "infisical run --env=dev --path=/apps/demo -- sh -c 'LOWDEFY_SECRET_REPORTING_DATA_MONGODB_URI=\"$LOWDEFY_SECRET_MONGODB_URI\" lowdefy-reporting-catalog --include \"demo_*\" --out modules/ai-reporting/catalog.draft.yaml'"
  },
  "dependencies": {
    "lowdefy": "0.0.0-experimental-20260814133003"
  },
  "devDependencies": {
    "@lowdefy/community-plugin-e2e-mdb": "latest",
    "@lowdefy/e2e-utils": "0.0.0-experimental-20260814133003",
    "@lowdefy/modules-mongodb-plugins": "workspace:*",
    "@playwright/test": "^1.50.0"
  }
}
