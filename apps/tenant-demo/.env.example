# Local env for apps/tenant-demo — copy to `.env` and fill in:
#
#   cp .env.example .env
#
# Every value here is a placeholder; nothing in this file is a real credential.
# `.env` is gitignored. The full secret list is in docs/shared/secrets.md.

# BetterAuth session/token signing secret. Generate: openssl rand -base64 32
LOWDEFY_SECRET_AUTH_SECRET=''

# Required to run the app (`ldf:d` / `ldf:s`). `ldf:b` supplies its own
# build-only placeholder, so a build check does not need this.
# Generate: openssl rand -base64 32
NEXTAUTH_SECRET=''

# One connection serves every module. The tenant policy writes organizations
# and memberships into this database, so point it at one of your own.
LOWDEFY_SECRET_MONGODB_URI='mongodb://localhost:27017/modules-mongodb-tenant-demo'

# From address on auth emails (verify, reset, magic-link, invite).
LOWDEFY_SECRET_AUTH_FROM_ADDRESS='no-reply@tenant-demo.test'

# SMTP transport for auth email (the auth-smtp connection), pointed at a local
# Mailpit catcher. Mailpit accepts any credentials but nodemailer throws EAUTH
# on a null user/pass, so these carry dummy values rather than being absent.
# For a real provider (SendGrid): smtp.sendgrid.net / 465 / true / apikey / <api key>.
LOWDEFY_SECRET_SMTP_HOST=localhost
LOWDEFY_SECRET_SMTP_PORT=1025
LOWDEFY_SECRET_SMTP_SECURE=false
LOWDEFY_SECRET_SMTP_USER=mailpit
LOWDEFY_SECRET_SMTP_PASS=mailpit

# The GitHub login button and the files/S3 tiles are not exercised by the tenant
# flows; these dummies only keep the config resolving. Replace with real values
# to use them. (The auth provider is GitHub — matching auth.providers in
# lowdefy.yaml; there is no Google provider.)
LOWDEFY_SECRET_GITHUB_CLIENT_ID='dummy'
LOWDEFY_SECRET_GITHUB_CLIENT_SECRET='dummy'
LOWDEFY_SECRET_FILES_S3_ACCESS_KEY_ID='dummy'
LOWDEFY_SECRET_FILES_S3_SECRET_ACCESS_KEY='dummy'
LOWDEFY_SECRET_FILES_S3_BUCKET='dummy-bucket'
LOWDEFY_SECRET_FILES_S3_BUCKET_PUB='dummy-bucket-pub'

# Pins the canonical origin — must match the port the app serves on (3003).
# BetterAuth falls back to per-request host derivation without it, but the
# invitation accept URL has no such fallback: getBetterAuthConfig only builds
# it when the origin is a fixed string, so the invitation email renders with
# no accept button until this is set.
BETTER_AUTH_URL=http://localhost:3003
