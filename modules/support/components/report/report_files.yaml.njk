# The report's screenshot: a picture of the page behind the panel, uploaded
# through the module's upload policy and added to {{ prefix }}.files, which
# the report's message box lists with the images and PDFs dropped or pasted
# into it. Five files in all. The panel and any open drawer are left out of the
# picture.
id: {{ prefix }}_files_box
type: Box
blocks:
  - id: {{ prefix }}_screenshot
    type: SupportScreenshot
    properties:
      s3PostPolicyRequestId: upload_policy_{{ prefix }}_files
      hideSelectors:
        - "#support_panel"
        - ".ant-drawer-root"
      maskSelectors:
        _module.var: mask_selectors
      disabled:
        _gte:
          - _array.length:
              _if_none:
                - _state: {{ prefix }}.files
                - []
          - 5
    events:
      onUse:
        - id: {{ prefix }}_add_screenshot
          type: SetState
          params:
            {{ prefix }}.files:
              _array.concat:
                - _if_none:
                    - _state: {{ prefix }}.files
                    - []
                - - _event: file
      onError:
        - id: {{ prefix }}_screenshot_failed
          type: SetState
          params:
            {{ prefix }}_error:
              _event: message
